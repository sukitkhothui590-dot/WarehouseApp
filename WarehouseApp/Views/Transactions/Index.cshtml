@model TransactionsViewModel
@{ ViewData["Title"] = "Transactions"; }
<div class="page-heading"><div><p class="eyebrow">Audit trail</p><h2>Transactions</h2><p class="muted">A complete record of stock movements.</p></div></div>
<section class="panel"><form class="filter-bar transaction-filters" method="get"><div class="filter-group"><label for="filter">Type</label><select id="filter" name="filter" class="form-select"><option value="all" selected="@(Model.Filter == "all")">All movements</option><option value="receive" selected="@(Model.Filter == "receive")">Receive</option><option value="withdraw" selected="@(Model.Filter == "withdraw")">Withdraw</option></select></div><div class="filter-group"><label for="productId">Product</label><select id="productId" name="productId" class="form-select"><option value="">All products</option>@foreach (var product in Model.Products) { <option value="@product.Id" selected="@(Model.ProductId == product.Id)">@product.Code — @product.Name</option> }</select></div><button class="btn btn-light filter-submit" type="submit">Apply filters</button></form><div class="table-responsive"><table class="table app-table align-middle"><thead><tr><th>Date / time</th><th>Product</th><th>Type</th><th>Quantity</th><th>Balance before</th><th>Balance after</th><th>Note</th></tr></thead><tbody>@foreach (var item in Model.Transactions) { <tr><td class="muted">@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td><td><a class="table-link" asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId">@item.Product.Code<span class="d-block muted small">@item.Product.Name</span></a></td><td><span class="status-badge @(item.TransactionType == TransactionType.IN ? "receive" : "withdraw")">@(item.TransactionType == TransactionType.IN ? "Receive" : "Withdraw")</span></td><td><strong>@item.Quantity</strong> @item.Product.Unit</td><td>@item.BalanceBefore</td><td><strong>@item.BalanceAfter</strong></td><td class="muted">@(item.Note ?? "—")</td></tr> } @if (Model.Transactions.Count == 0) { <tr><td colspan="7"><div class="empty-state">No transactions found.</div></td></tr> }</tbody></table></div></section>
