@model ProductFormViewModel
<section class="panel form-panel"><form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div><div class="form-grid"><div class="form-field"><label asp-for="Code"></label><input asp-for="Code" class="form-control" placeholder="e.g. P100" autocomplete="off" /><span asp-validation-for="Code" class="text-danger"></span></div><div class="form-field"><label asp-for="Name"></label><input asp-for="Name" class="form-control" placeholder="e.g. Test Product" /><span asp-validation-for="Name" class="text-danger"></span></div><div class="form-field"><label asp-for="Unit"></label><input asp-for="Unit" class="form-control" placeholder="e.g. pcs" /><span asp-validation-for="Unit" class="text-danger"></span></div></div><div class="form-actions"><a class="btn btn-light" asp-action="Index">Cancel</a><button class="btn btn-primary" type="submit">@(Model.Id == 0 ? "Create product" : "Save changes")</button></div></form></section>
