@model ProductDetailViewModel
@{ ViewData["Title"] = "Product detail"; }
<div class="page-heading"><div><p class="eyebrow">Product detail</p><h2>@Model.Product.Name</h2><p class="muted">@Model.Product.Code · @Model.Product.Unit</p></div><div class="heading-actions"><a class="btn btn-light" asp-action="Edit" asp-route-id="@Model.Product.Id">Edit product</a><a class="btn btn-primary" asp-controller="Stock" asp-action="Receive">+ Receive stock</a></div></div>
<div class="detail-card"><img class="detail-product-image" src="~/images/products/@Model.Product.ImageFileName" alt="@Model.Product.Name" /><div><span class="eyebrow">Current stock</span><div class="detail-stock">@Model.Product.Quantity <small>@Model.Product.Unit</small></div></div><div class="detail-meta"><span>Created</span><strong>@Model.Product.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</strong></div><div class="detail-meta"><span>Last updated</span><strong>@Model.Product.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</strong></div></div>
<section class="panel"><div class="panel-header"><div><h3>Transaction history</h3><p class="muted">Every stock movement for this product</p></div></div><div class="table-responsive"><table class="table app-table"><thead><tr><th>Date / time</th><th>Type</th><th>Quantity</th><th>Before</th><th>After</th><th>Note</th></tr></thead><tbody>@foreach (var item in Model.Transactions) { <tr><td>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td><td><span class="status-badge @(item.TransactionType == TransactionType.IN ? "receive" : "withdraw")">@(item.TransactionType == TransactionType.IN ? "Receive" : "Withdraw")</span></td><td>@item.Quantity @Model.Product.Unit</td><td>@item.BalanceBefore</td><td><strong>@item.BalanceAfter</strong></td><td class="muted">@(item.Note ?? "—")</td></tr> } @if (Model.Transactions.Count == 0) { <tr><td colspan="6"><div class="empty-state">No transactions for this product yet.</div></td></tr> }</tbody></table></div></section>
