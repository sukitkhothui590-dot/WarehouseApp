@model InventoryViewModel
@{ ViewData["Title"] = "Inventory"; }
<div class="page-heading"><div><p class="eyebrow">Stock control</p><h2>Inventory</h2><p class="muted">Current stock levels across the warehouse.</p></div><div class="heading-actions"><a class="btn btn-primary" asp-controller="Stock" asp-action="Receive">+ Receive stock</a><a class="btn btn-light" asp-controller="Stock" asp-action="Withdraw">Withdraw stock</a></div></div>
<section class="panel"><form class="filter-bar" method="get"><div class="search-wrap"><span>⌕</span><input name="search" value="@Model.Search" placeholder="Search by code or product name..." aria-label="Search inventory" /></div><button class="btn btn-light" type="submit">Search</button>@if (!string.IsNullOrWhiteSpace(Model.Search)) { <a class="clear-filter" asp-action="Index">Clear</a> }</form><div class="table-responsive"><table class="table app-table align-middle"><thead><tr><th>Product code</th><th>Product name</th><th>Unit</th><th>Current quantity</th><th>Last updated</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var product in Model.Products) { var status = product.Quantity == 0 ? "Out of stock" : product.Quantity <= 5 ? "Low stock" : "In stock"; <tr><td><span class="code-label">@product.Code</span></td><td><a class="product-cell" asp-controller="Products" asp-action="Details" asp-route-id="@product.Id"><img class="product-thumb" src="~/images/products/@product.ImageFileName" alt="" loading="lazy" /><span><strong>@product.Name</strong><small>@product.Code</small></span></a></td><td>@product.Unit</td><td class="quantity-cell">@product.Quantity</td><td class="muted">@product.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td><td><span class="status-badge @(product.Quantity == 0 ? "out" : product.Quantity <= 5 ? "low" : "in")">@status</span></td><td class="text-end"><a class="btn btn-sm btn-light" asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">Details</a></td></tr> } @if (Model.Products.Count == 0) { <tr><td colspan="7"><div class="empty-state">No products match your search.</div></td></tr> }</tbody></table></div></section>
